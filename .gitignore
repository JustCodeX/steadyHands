app/assets/clips/*.wav
app/logs/*.csv
.pytest_cache/

# Hand-over notes can hold board passwords
handoff-*.md

# Pitch .pptx embeds the video (50-60 MB): shipped as a GitHub release asset, not in git
pitch/*.pptx
